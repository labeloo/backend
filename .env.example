# Copy to .env for local development. Never commit the real .env.

# Signs AND verifies JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-openssl-rand-hex-32

# libsql connection string. Used by the server, drizzle-kit and the seed script alike.
DATABASE_URL=file:database.db

HOST=0.0.0.0
PORT=8787

# Exact-match list, no wildcards. Add every browser origin that calls this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Request headers the browser may send. The API reads orgId/projectId/id/word/export-format.
# CORS_HEADERS=Content-Type,Authorization,orgId,projectId,id,word,export-format

# Account created by `pnpm seed` on an empty database.
ADMIN_EMAIL=admin@labeloo.local
ADMIN_PASSWORD=change-me

# DANGER: enables POST /query, which runs arbitrary SQL with no authentication.
# ENABLE_DEBUG_QUERY=false
