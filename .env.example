# Copy to .env and fill in real values. NEVER commit the real .env.

# REQUIRED. Secret used to sign & verify JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=

# libSQL/SQLite connection string. Defaults to file:database.db when unset.
DATABASE_URL=file:database.db

# Seed admin (used by `npx ts-node script.ts`).
ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=change-me
